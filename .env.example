# Salt for the one-way IP hash stored on each signup. Any long random string.
# Without it the endpoint simply omits ipHash rather than storing a raw IP.
WELCOME_IP_HASH_SALT=change-me-to-a-long-random-string


# Claims allowed per IP per hour. Best-effort only: the counter lives in
# process memory, so on serverless it applies per instance, not globally.
WELCOME_RATE_LIMIT_MAX=5


