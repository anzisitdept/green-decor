NEXT_PUBLIC_FIREBASE_PROJECT_ID=green-decor-97d67
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=green-decor-97d67.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1017052237871
NEXT_PUBLIC_FIREBASE_APP_ID=1:1017052237871:web:f4d66b5fbecc76749836da
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-J2L59GB3RY


# ===========================================================================
# REQUIRED server-only service account.
#
# /api/welcome-coupon, /api/redeem-coupon and /api/newsletter all mint and
# verify coupons through the firebase-admin SDK, which bypasses Firestore
# security rules. That SDK has no way to reach Firestore without a service
# account, so if any of the three below is missing the popup answers
# "We could not generate a discount code. Please try again." with a 500.
#
# These are NOT the NEXT_PUBLIC_* values above - the browser keys are not
# allowed to write to `coupons`. Copy them from Firebase console >
# Project settings > Service accounts > Generate new private key.
#
# Keep FIREBASE_PRIVATE_KEY in double quotes with \n escapes. Pasting a real
# multi-line PEM into a single-line env var (Vercel, CI) breaks it.
# ===========================================================================
FIREBASE_PROJECT_ID=green-decor-97d67
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@green-decor-97d67.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"


# The welcome offer. Read by /api/welcome-coupon.
WELCOME_COUPON_PERCENT=5
WELCOME_COUPON_MIN_ORDER=0
WELCOME_COUPON_USAGE_LIMIT=1
WELCOME_COUPON_VALID_DAYS=30


# Salt for the one-way IP hash stored on each signup. Any long random string.
# Without it the endpoint simply omits ipHash rather than storing a raw IP.
WELCOME_IP_HASH_SALT=change-me-to-a-long-random-string


# Claims allowed per IP per hour. Best-effort only: the counter lives in
# process memory, so on serverless it applies per instance, not globally.
WELCOME_RATE_LIMIT_MAX=5


SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@greendecor.pk
SMTP_PASS=your-hostinger-app-password

NOTIFY_EMAIL=info@greendecor.pk


SMTP_FROM_NAME=Green Decor
SMTP_FROM_EMAIL=info@greendecor.pk

NOTIFY_DRY_RUN=false

# Google Gemini API key for Design Studio AI
GEMINI_API_KEY=your-gemini-api-key

